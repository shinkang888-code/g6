# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local dev data
/.data/
/g6/.venv/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (개인 리포 — 주요 .env 커밋 허용)
.env*
!.env
!.env.local
!.env.production.local
!.env.example
!**/.env.example
!bot/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android TWA (Bubblewrap 빌드 산출물·키)
android-twa/android.keystore
android-twa/*.apk
android-twa/*.aab
android-twa/build/
android-twa/.gradle/
android-twa/app/build/
android-twa/local.properties

# local CLI tools (do not commit)
.tools/
